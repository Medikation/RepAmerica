NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://repamerica.com
# SUPABASE_SERVICE_ROLE_KEY=   (server only — orders/subscribers)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Commerce (Stripe Checkout; orders land in Supabase `orders` via /api/stripe-webhook) ---
# STRIPE_SECRET_KEY=sk_live_...        # Stripe Dashboard → Developers → API keys. Unset = /api/checkout returns 503 "Checkout is not configured yet".
# STRIPE_WEBHOOK_SECRET=whsec_...      # Stripe Dashboard → Developers → Webhooks → endpoint https://repamerica.com/api/stripe-webhook (event: checkout.session.completed) → Signing secret.
# SUPABASE_SERVICE_ROLE_KEY is also required by the webhook (it inserts into `orders`).
